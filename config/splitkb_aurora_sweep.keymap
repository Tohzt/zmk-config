#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

&mt {
    //  flavor = "tap-preferred";
    // tapping-term-ms = <200>;

    flavor = "tap-preferred";
    tapping-term-ms = <150>;
};

/ {
    combos {
        compatible = "zmk,combos";

        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
        };

        combo_tab {
            timeout-ms = <50>;
            key-positions = <10 11>;
            bindings = <&kp TAB>;
        };

        Semicolon {
            bindings = <&kp EQUAL>;
            key-positions = <8 9>;
        };

        game_mode {
            bindings = <&game_layer>;
            key-positions = <2 1 3>;
        };

        default_mode {
            bindings = <&default_layer>;
            key-positions = <21 22 23>;
        };

        combo_left_layer {
            bindings = <&left_layer>;
            key-positions = <30 31>;
        };

        combo_right_layer {
            bindings = <&right_layer>;
            key-positions = <33 32>;
        };

        combo_underscore {
            bindings = <&kp UNDERSCORE>;
            key-positions = <31 32>;
        };

        combo_enter {
            bindings = <&kp ENTER>;
            key-positions = <19 18>;
            timeout-ms = <50>;
            require-prior-idle-ms = <10>;
        };
    };

    macros {
        default_layer: default_layer {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0>;
            label = "DEFAULT_LAYER";
        };

        left_layer: left_layer {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 1>;
            label = "LEFT_LAYER";
        };

        right_layer: right_layer {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 2>;
            label = "RIGHT_LAYER";
        };

        game_layer: game_layer {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 3>;
            label = "GAME_LAYER";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W             &kp E           &kp R               &kp T    &kp Y  &kp U                &kp I            &kp O              &kp P
&mt LEFT_GUI A    &mt LEFT_SHIFT S  &mt LEFT_ALT D  &mt LEFT_CONTROL F  &kp G    &kp H  &mt RIGHT_CONTROL J  &mt RIGHT_ALT K  &mt RIGHT_SHIFT L  &mt RIGHT_GUI SEMICOLON
&mt LEFT_SHIFT Z  &kp X             &kp C           &kp V               &kp B    &kp N  &kp M                &kp COMMA        &kp DOT            &kp SLASH
&mo 1             &kp BACKSPACE                                                                                               &kp SPACE          &mo 2
            >;
        };

        left_layer {
            bindings = <
&kp F1             &kp F4  &kp F7  &kp F10  &rgb_ug RGB_BRI    &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp PLUS      &kp MINUS
&kp F2             &kp F5  &kp F8  &kp F11  &rgb_ug RGB_TOG    &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp ASTERISK  &kp SLASH
&mt LEFT_SHIFT F3  &kp F6  &kp F9  &kp F12  &rgb_ug RGB_BRD    &kp N7        &kp N8        &kp N9        &kp N0        &kp EQUAL
&trans             &none                                                                                 &kp KP_EQUAL  &kp N0
            >;
        };

        right_layer {
            bindings = <
&kp GRAVE             &kp EXCLAMATION  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp LC(X)    &kp LG(LEFT)    &kp LG(DOWN_ARROW)  &kp LG(UP_ARROW)  &kp LG(RIGHT_ARROW)  &kp LS(GRAVE)
&kp SQT               &kp EQUAL        &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LC(C)    &kp LEFT_ARROW  &kp DOWN_ARROW      &kp UP_ARROW      &kp RIGHT            &kp SQT
&mt LEFT_SHIFT ENTER  &kp QUESTION     &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp LC(V)    &kp SEMICOLON   &kp EXCLAMATION     &kp COMMA         &kp PERIOD           &kp SLASH
&kp SPACE             &kp BACKSPACE                                                                                                                    &none                &mo 2
            >;
        };

        game_layer {
            bindings = <
&kp TAB           &kp Q      &kp I  &kp E  &kp R    &rgb_ug RGB_COLOR_HSB(0,97,48)  &rgb_ug RGB_COLOR_HSB(58,93,49)  &rgb_ug RGB_COLOR_HSB(109,98,49)  &rgb_ug RGB_COLOR_HSB(177,95,50)  &rgb_ug RGB_COLOR_HSB(242,91,48)
&kp LEFT_SHIFT    &kp A      &kp W  &kp D  &kp F    &rgb_ug RGB_SPI                 &rgb_ug RGB_HUI                  &rgb_ug RGB_BRI                   &rgb_ug RGB_EFF                   &none
&kp LEFT_CONTROL  &kp Z      &kp S  &kp C  &kp V    &rgb_ug RGB_SPD                 &rgb_ug RGB_HUD                  &rgb_ug RGB_BRD                   &rgb_ug RGB_EFR                   &kp ENTER
&mo 4             &kp SPACE                                                                                                                            &bl BL_CYCLE                      &rgb_ug RGB_COLOR_HSB(300,100,51)
            >;
        };

        game_layer_2 {
            bindings = <
&kp N1  &kp N2  &kp N3  &kp N4  &kp N5    &none  &none  &none  &none  &none
&kp N6  &kp N7  &kp N8  &kp N9  &kp N0    &none  &none  &none  &none  &none
&kp L   &kp O   &kp M   &kp G   &kp B     &none  &none  &none  &none  &none
&trans  &none                                                  &none  &none
            >;
        };
    };
};
